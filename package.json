{
	"name": "velkro",
	"version": "1.0.0",
	"description": "Module-based Node.js API Framework built on Koa (the successor to Express)",
	"type": "module",
	"main": "lib/application.js",
	"scripts": {
		"test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
		"test-watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write ."
	},
	"repository": "rickyk586/velkro",
	"keywords": [
		"web",
		"app",
		"http",
		"application",
		"framework",
		"middleware",
		"module"
	],
	"dependencies": {
		"@koa/bodyparser": "^6.1.0",
		"@koa/cors": "^5.0.0",
		"@koa/router": "^15.3.1",
		"debug": "^4.4.3",
		"glob": "^13.0.6",
		"jsonwebtoken": "^9.0.3",
		"koa": "^3.1.2",
		"koa-jwt": "^4.0.4",
		"lodash-es": "^4.17.23"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"cross-env": "^10.1.0",
		"eslint": "^10.0.3",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"globals": "^17.4.0",
		"jest": "^30.2.0",
		"prettier": "^3.8.1",
		"supertest": "^7.2.2"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"files": [
		"lib"
	],
	"jest": {
		"testMatch": [
			"**/test/tests/**/*.js"
		],
		"coverageReporters": [
			"text-summary",
			"lcov"
		],
		"bail": true,
		"testEnvironment": "node",
		"transform": {}
	}
}
